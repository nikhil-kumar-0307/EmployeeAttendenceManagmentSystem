@{
    var role = Session["Role"] as string;
    var isAdmin = role == "Admin";
    var fullName = Session["FullName"] as string;
    var initial = string.IsNullOrWhiteSpace(fullName) ? "?" : fullName.Trim().Substring(0, 1).ToUpper();

    var controller = (string)ViewContext.RouteData.Values["controller"];
    var action = (string)ViewContext.RouteData.Values["action"];

    // Navigation tabs depend on who is signed in
    var tabs = isAdmin
        ? new[]
        {
            new { Label = "Home", Controller = "AdminDashboard", Action = "Index", Match = new[] { "Index" } },
            new { Label = "Assign subordinates", Controller = "AdminDashboard", Action = "Assignments", Match = new[] { "Assignments", "Manage", "Add", "Remove" } },
            new { Label = "Reset passwords", Controller = "AdminDashboard", Action = "ResetPasswords", Match = new[] { "ResetPasswords", "ResetPassword" } }
                }
        : new[]
        {
            new { Label = "Home", Controller = "EmployeeDashboard", Action = "Index", Match = new[] { "Index" } },
            new { Label = "My attendance", Controller = "EmployeeDashboard", Action = "MyAttendance", Match = new[] { "MyAttendance" } },
            new { Label = "Subordinate attendance", Controller = "EmployeeDashboard", Action = "SubordinateAttendance", Match = new[] { "SubordinateAttendance", "SubordinateMonthly" } }
                };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title | Employee Attendance Management System</title>
    <link href="~/Content/portal.css" rel="stylesheet" />

    <style>
        /* ===== Layout chrome (header, navigation bar, footer) ===== */
        :root {
            --navy: #0a2a4a;
            --navy-2: #123f6e;
            --gold: #f5b400;
            --blue: #1d7fd6;
            --ink: #14213d;
            --muted: #64708a;
            --line: #e1e7f0;
            --font: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font);
            color: var(--ink);
            background: #f1f4f9;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        svg {
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* top strip */
        .topbar {
            background: var(--navy);
            color: #cfe0f3;
            font-size: 12.5px;
        }

        .topbar-inner {
            padding: 7px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .topbar-left {
            display: flex;
            align-items: baseline;
            gap: 12px;
        }

            .topbar-left strong {
                color: #fff;
                font-size: 14px;
                letter-spacing: .4px;
            }

                .topbar-left strong span {
                    font-weight: 300;
                    margin: 0 3px;
                    opacity: .7;
                }

            .topbar-left em {
                font-style: normal;
                color: #a9bdd6;
            }

        .topbar-right {
            color: #a9bdd6;
            white-space: nowrap;
        }

        /* main header: logo | plant name | logo */
        .masthead {
            background: #fff;
            box-shadow: 0 2px 14px rgba(10, 42, 74, .10);
            position: relative;
            z-index: 3;
        }

        .masthead-inner {
            padding: 12px 32px 14px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 24px;
        }

        .logo-left {
            justify-self: start;
        }

        .logo-right {
            justify-self: end;
        }

        .logo-img {
            display: block;
            height: 54px;
            width: auto;
        }

        .plant-title {
            text-align: center;
        }

            .plant-title h1 {
                margin: 0;
                font-size: 24px;
                font-weight: 800;
                letter-spacing: .8px;
                color: var(--navy);
                line-height: 1.2;
            }

        .title-rule {
            display: block;
            width: 60px;
            height: 3px;
            border-radius: 3px;
            background: var(--gold);
            margin: 7px auto;
        }

        .plant-title p {
            margin: 0;
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: .3px;
        }

        .masthead-stripe {
            height: 4px;
            background: linear-gradient(90deg, var(--navy) 0%, var(--blue) 55%, var(--gold) 100%);
        }

        /* navigation bar */
        .navbar {
            background: #fff;
            border-bottom: 1px solid var(--line);
        }

        .navbar-inner {
            padding: 0 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .tabs {
            display: flex;
            gap: 4px;
            overflow-x: auto;
        }

        .tab {
            position: relative;
            padding: 15px 16px;
            font-size: 14px;
            font-weight: 600;
            color: var(--muted);
            white-space: nowrap;
        }

            .tab:hover {
                color: var(--ink);
            }

            .tab.active {
                color: var(--blue);
            }

                .tab.active::after {
                    content: "";
                    position: absolute;
                    left: 12px;
                    right: 12px;
                    bottom: -1px;
                    height: 3px;
                    border-radius: 3px 3px 0 0;
                    background: var(--blue);
                }

        .user-area {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 8px 0;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--navy);
            color: #fff;
            display: grid;
            place-items: center;
            font-weight: 700;
            font-size: 15px;
            flex: none;
        }

        .user-chip {
            line-height: 1.25;
        }

            .user-chip strong {
                display: block;
                font-size: 13.5px;
            }

            .user-chip small {
                color: var(--muted);
                font-size: 12px;
            }

        .role-chip {
            display: inline-block;
            margin-left: 6px;
            padding: 1px 8px;
            border-radius: 999px;
            background: #fff3d6;
            color: #8a5a00;
            font-size: 11px;
            font-weight: 700;
        }

        .link-btn {
            font-size: 13px;
            font-weight: 600;
            color: var(--blue);
            padding: 8px 2px;
            white-space: nowrap;
        }

            .link-btn:hover, .link-btn.active {
                text-decoration: underline;
            }

        .logout-form {
            margin: 0;
        }

        .btn-logout {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            border: 1px solid var(--line);
            background: #fff;
            color: var(--ink);
            font: 600 13px var(--font);
        }

            .btn-logout svg {
                width: 15px;
                height: 15px;
            }

            .btn-logout:hover {
                border-color: #c9d3e2;
                background: #f7f9fc;
            }

            .btn-logout:focus-visible, .tab:focus-visible {
                outline: 3px solid var(--gold);
                outline-offset: 2px;
            }

        /* footer */
        .site-footer {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: #8895ad;
            border-top: 1px solid var(--line);
            background: #fff;
        }

        /* responsive */
        @@media (max-width: 1000px) {
            .topbar-left em, .topbar-right {
                display: none;
            }

            .topbar-inner {
                justify-content: center;
                padding: 7px 16px;
            }

            .masthead-inner {
                grid-template-columns: auto 1fr;
                padding: 10px 16px;
                gap: 14px;
            }

            .logo-right {
                display: none;
            }

            .plant-title {
                text-align: left;
            }

                .plant-title h1 {
                    font-size: 16px;
                }

            .title-rule {
                margin-left: 0;
            }

            .logo-img {
                height: 42px;
            }

            .navbar-inner {
                padding: 0 16px;
            }
        }

        @@media (max-width: 700px) {
            .navbar-inner {
                flex-direction: column;
                align-items: stretch;
                gap: 0;
            }

            .user-area {
                justify-content: space-between;
                border-top: 1px solid var(--line);
            }
        }
    </style>
</head>
<body>

    <!-- ===== Top strip ===== -->
    <div class="topbar">
        <div class="topbar-inner">
            <div class="topbar-left">
                <strong>संगम <span>|</span> SANGAM</strong>
                <em>Powering Unification Of Processes</em>
            </div>
            <div class="topbar-right">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>
    </div>

    <!-- ===== Main header: logo | plant name | logo ===== -->
    <header class="masthead">
        <div class="masthead-inner">
            <div class="logo-left">
                <img src="~/Content/images/ntpc-logo.png" alt="NTPC" class="logo-img" />
            </div>

            <div class="plant-title">
                <h1>KAHALGAON SUPER THERMAL POWER STATION</h1>
                <span class="title-rule" aria-hidden="true"></span>
                <p>2340 MW (STAGE-1: 4X210, STAGE-2: 3X500)</p>
            </div>

            <div class="logo-right">
                <img src="~/Content/images/ntpc-logo.png" alt="NTPC" class="logo-img" />
            </div>
        </div>
        <div class="masthead-stripe" aria-hidden="true"></div>
    </header>

    <!-- ===== Navigation + user ===== -->
    <div class="navbar">
        <div class="navbar-inner">
            <nav class="tabs" aria-label="Main">
                @foreach (var t in tabs)
                {
                    var active = Array.IndexOf(t.Match, action) >= 0;
                    <a class="tab @(active ? "active" : "")" href="@Url.Action(t.Action, t.Controller)" @(active ? "aria-current=page" : "")>@t.Label</a>
                }
            </nav>

            <div class="user-area">
                <span class="user-avatar" aria-hidden="true">@initial</span>
                <div class="user-chip">
                    <strong>@fullName @if (isAdmin)
                    {<span class="role-chip">Admin</span>}</strong>
                    <small>@(isAdmin ? "Admin ID" : "Emp. No") @Session["EmployeeCode"]</small>
                </div>
                <a class="link-btn @(controller == "Account" && action == "ChangePassword" ? "active" : "")" href="@Url.Action("ChangePassword", "Account")">Change password</a>
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "logout-form" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">
                        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Sign out
                    </button>
                }
            </div>
        </div>
    </div>

    <main class="page">
        @RenderBody()
    </main>

    <footer class="site-footer">&copy; @DateTime.Now.Year NTPC Kahalgaon. All rights reserved.</footer>
</body>
</html>