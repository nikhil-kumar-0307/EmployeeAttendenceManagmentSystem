<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title | Employee Attendance Management System</title>
    <link href="~/Content/portal.css" rel="stylesheet" />
</head>
<body>

    <header class="site-header">
        <div class="header-inner">
            <div class="brand">
                <img src="~/Content/images/ntpc-logo.png" alt="NTPC" class="brand-logo" />
                <div class="brand-text">
                    <div class="brand-name">संगम <span>|</span> SANGAM</div>
                    <div class="brand-tag">Powering Unification Of Processes</div>
                </div>
            </div>

            <div class="plant-title">
                <h1>KAHALGAON SUPER THERMAL POWER STATION</h1>
                <p>2340 MW (STAGE-1: 4X210, STAGE-2: 3X500)</p>
            </div>

            <div class="header-logo-right">
                <img src="~/Content/images/ntpc-logo.png" alt="NTPC" class="brand-logo" />
            </div>
        </div>
    </header>

    <div class="subbar">
        <div class="subbar-inner">
            <nav class="crumbs" aria-label="Breadcrumb">
                <a href="@Url.Action("Index", "EmployeeDashboard")">Home</a>
                @if (ViewBag.Crumb != null)
                {
                    <span class="sep">/</span>
                    <span class="here">@ViewBag.Crumb</span>
                }
            </nav>

            <div class="user-area">
                <div class="user-chip">
                    <strong>@Session["FullName"]</strong>
                    <small>Emp. No @Session["EmployeeCode"]</small>
                </div>
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "logout-form" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">
                        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Sign out
                    </button>
                }
            </div>
        </div>
    </div>

    <main class="page">
        @RenderBody()
    </main>

    <footer class="site-footer">&copy; @DateTime.Now.Year NTPC Kahalgaon. All rights reserved.</footer>
</body>
</html>
