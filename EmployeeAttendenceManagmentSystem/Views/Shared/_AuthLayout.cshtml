<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title | Employee Attendance Management System</title>

    <style>
        :root {
            --navy: #0a2a4a;
            --navy-2: #123f6e;
            --gold: #f5b400;
            --blue: #1d5fe0;
            --blue-dark: #174fc0;
            --ink: #14213d;
            --muted: #64708a;
            --line: #dbe2ec;
            --bg: #eef2f7;
            --error: #b3261e;
            --error-bg: #fdecea;
            --font: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font);
            color: var(--ink);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
            background: radial-gradient(900px 420px at 50% 0%, #dbe7f6 0%, rgba(219, 231, 246, 0) 70%), var(--bg);
        }

        svg {
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        a {
            text-decoration: none;
        }

        /* top strip */
        .topbar {
            background: var(--navy);
            color: #cfe0f3;
            font-size: 12.5px;
        }

        .topbar-inner {
            padding: 7px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .topbar-left {
            display: flex;
            align-items: baseline;
            gap: 12px;
        }

            .topbar-left strong {
                color: #fff;
                font-size: 14px;
                letter-spacing: .4px;
            }

                .topbar-left strong span {
                    font-weight: 300;
                    margin: 0 3px;
                    opacity: .7;
                }

            .topbar-left em {
                font-style: normal;
                color: #a9bdd6;
            }

        .topbar-right {
            color: #a9bdd6;
            white-space: nowrap;
        }

        /* main header */
        .masthead {
            background: #fff;
            box-shadow: 0 2px 14px rgba(10, 42, 74, .10);
            position: relative;
            z-index: 2;
        }

        .masthead-inner {
            padding: 14px 32px 16px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 24px;
        }

        .logo-left {
            justify-self: start;
        }

        .logo-right {
            justify-self: end;
        }

        .logo-img {
            display: block;
            height: 58px;
            width: auto;
        }

        .plant-title {
            text-align: center;
        }

            .plant-title h1 {
                margin: 0;
                font-size: 26px;
                font-weight: 800;
                letter-spacing: .8px;
                color: var(--navy);
                line-height: 1.2;
            }

        .title-rule {
            display: block;
            width: 64px;
            height: 3px;
            border-radius: 3px;
            background: var(--gold);
            margin: 8px auto;
        }

        .plant-title p {
            margin: 0;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: .3px;
        }

        .masthead-stripe {
            height: 4px;
            background: linear-gradient(90deg, var(--navy) 0%, var(--blue) 55%, var(--gold) 100%);
        }

        /* page */
        .login-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }

        .auth-card {
            width: 100%;
            max-width: 480px;
            background: #fff;
            border-radius: 18px;
            padding: 36px 40px 30px;
            box-shadow: 0 26px 60px rgba(10, 42, 74, .18), 0 2px 6px rgba(10, 42, 74, .08);
            animation: rise .45s ease both;
        }

        @@keyframes rise {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        .side-tag {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 999px;
            margin-bottom: 14px;
            background: #fff3d6;
            color: #8a5a00;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .4px;
        }

        .auth-card h3 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -.2px;
        }

        .sub {
            margin: 6px 0 20px;
            font-size: 14px;
            color: var(--muted);
            line-height: 1.5;
        }

        /* fields */
        .field-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin: 16px 0 6px;
        }

        .input-box {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 0 12px;
            background: #fafbfd;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }

            .input-box:focus-within {
                border-color: var(--blue);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(29, 95, 224, .15);
            }

            .input-box .ico {
                width: 18px;
                height: 18px;
                color: #8895ad;
                flex: none;
            }

            .input-box input {
                flex: 1;
                min-width: 0;
                border: 0;
                outline: 0;
                background: transparent;
                padding: 13px 0;
                font: 15px var(--font);
                color: var(--ink);
            }

                .input-box input::placeholder {
                    color: #9aa6bb;
                }

                .input-box input:-webkit-autofill {
                    -webkit-box-shadow: 0 0 0 40px #fafbfd inset;
                    -webkit-text-fill-color: var(--ink);
                }

        .field-error, .field-validation-error {
            display: block;
            margin-top: 5px;
            font-size: 12.5px;
            color: var(--error);
        }

        .field-hint {
            margin: 6px 0 0;
            font-size: 12.5px;
            color: var(--muted);
        }

        .show-pass {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 14px;
            font-size: 13px;
            color: var(--muted);
            cursor: pointer;
        }

            .show-pass input {
                width: 16px;
                height: 16px;
                accent-color: var(--blue);
            }

        .btn-signin {
            width: 100%;
            margin-top: 22px;
            padding: 14px;
            border: 0;
            border-radius: 10px;
            cursor: pointer;
            background: linear-gradient(180deg, #2a6bec 0%, var(--blue) 100%);
            color: #fff;
            font: 700 15px var(--font);
            box-shadow: 0 6px 16px rgba(29, 95, 224, .30);
            transition: transform .12s, box-shadow .12s, background .12s;
        }

            .btn-signin:hover {
                background: linear-gradient(180deg, var(--blue) 0%, var(--blue-dark) 100%);
            }

            .btn-signin:active {
                transform: translateY(1px);
            }

            .btn-signin:disabled {
                opacity: .75;
                cursor: progress;
            }

            .btn-signin:focus-visible {
                outline: 3px solid var(--gold);
                outline-offset: 2px;
            }

        .back-login {
            display: block;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid #edf1f6;
            text-align: center;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--blue);
        }

            .back-login:hover {
                text-decoration: underline;
            }

        .alert-error {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            background: var(--error-bg);
            color: var(--error);
            border: 1px solid #f5c6c2;
            border-radius: 10px;
            padding: 11px 13px;
            font-size: 13.5px;
            margin-bottom: 4px;
        }

            .alert-error svg {
                width: 18px;
                height: 18px;
                flex: none;
                margin-top: 1px;
            }

            .alert-error ul, .validation-summary-errors ul {
                margin: 0;
                padding: 0;
                list-style: none;
            }

        .site-footer {
            text-align: center;
            padding: 16px;
            font-size: 12px;
            color: #7b88a1;
        }

        @@media (max-width: 1000px) {
            .topbar-left em, .topbar-right {
                display: none;
            }

            .topbar-inner {
                justify-content: center;
                padding: 7px 16px;
            }

            .masthead-inner {
                grid-template-columns: auto 1fr;
                padding: 12px 16px;
                gap: 14px;
            }

            .logo-right {
                display: none;
            }

            .plant-title {
                text-align: left;
            }

                .plant-title h1 {
                    font-size: 17px;
                }

            .title-rule {
                margin-left: 0;
            }

            .logo-img {
                height: 46px;
            }
        }

        @@media (max-width: 560px) {
            .login-wrap {
                align-items: flex-start;
                padding: 24px 14px;
            }

            .auth-card {
                padding: 28px 22px 24px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            * {
                transition: none !important;
                animation: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="topbar-inner">
            <div class="topbar-left">
                <strong>संगम <span>|</span> SANGAM</strong>
                <em>Powering Unification Of Processes</em>
            </div>
            <div class="topbar-right">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>
    </div>

    <header class="masthead">
        <div class="masthead-inner">
            <div class="logo-left"><img src="~/Content/images/ntpc-logo.png" alt="NTPC" class="logo-img" /></div>
            <div class="plant-title">
                <h1>KAHALGAON SUPER THERMAL POWER STATION</h1>
                <span class="title-rule" aria-hidden="true"></span>
                <p>2340 MW (STAGE-1: 4X210, STAGE-2: 3X500)</p>
            </div>
            <div class="logo-right"><img src="~/Content/images/ntpc-logo.png" alt="NTPC" class="logo-img" /></div>
        </div>
        <div class="masthead-stripe" aria-hidden="true"></div>
    </header>

    <main class="login-wrap">
        @RenderBody()
    </main>

    <footer class="site-footer">&copy; @DateTime.Now.Year NTPC Kahalgaon. All rights reserved.</footer>
</body>
</html>