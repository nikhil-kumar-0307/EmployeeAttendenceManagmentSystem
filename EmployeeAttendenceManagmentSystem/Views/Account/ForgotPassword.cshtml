@model EmployeeAttendenceManagmentSystem.Models.DTOs.ForgotPasswordDto
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = "Reset password";
}

<section class="auth-card">
    <span class="side-tag">Password reset</span>
    <h3>Forgot your password?</h3>
    <p class="sub">Confirm who you are with your employee number and date of birth, then choose a new password.</p>

    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "forgotForm", autocomplete = "off", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()

        if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
        {
            <div class="alert-error" role="alert">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                <span>@Html.ValidationSummary(true)</span>
            </div>
        }

        <label for="EmployeeNo" class="field-label">Employee No</label>
        <div class="input-box">
            <svg class="ico" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
            @Html.TextBoxFor(m => m.EmployeeNo, new { placeholder = "Enter your employee number", autofocus = "autofocus", autocomplete = "off" })
        </div>
        @Html.ValidationMessageFor(m => m.EmployeeNo, "", new { @class = "field-error" })

        <label for="DateOfBirth" class="field-label">Date of birth</label>
        <div class="input-box">
            <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @Html.TextBoxFor(m => m.DateOfBirth, new { placeholder = "DD/MM/YYYY", autocomplete = "off" })
        </div>
        @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "field-error" })

        <label for="NewPassword" class="field-label">New password</label>
        <div class="input-box">
            <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            @Html.PasswordFor(m => m.NewPassword, new { placeholder = "At least 6 characters", autocomplete = "new-password" })
        </div>
        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-error" })

        <label for="ConfirmPassword" class="field-label">Confirm new password</label>
        <div class="input-box">
            <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "Type the new password again", autocomplete = "new-password" })
        </div>
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error" })

        <label class="show-pass"><input type="checkbox" id="showPass" /> Show passwords</label>

        <button type="submit" class="btn-signin" id="btnReset"><span class="btn-label">Reset password</span></button>

        <a class="back-login" href="@Url.Action("Login", "Account")">&larr; Back to sign in</a>
    }
</section>

<script>
    (function () {
        var form = document.getElementById('forgotForm');
        var show = document.getElementById('showPass');
        show.addEventListener('change', function () {
            form.NewPassword.type = show.checked ? 'text' : 'password';
            form.ConfirmPassword.type = show.checked ? 'text' : 'password';
        });
        window.addEventListener('pageshow', function () {
            var b = document.getElementById('btnReset');
            b.disabled = false;
            b.querySelector('.btn-label').textContent = 'Reset password';
        });
        form.addEventListener('submit', function () {
            var b = document.getElementById('btnReset');
            b.disabled = true;
            b.querySelector('.btn-label').textContent = 'Please wait...';
        });
    })();
</script>