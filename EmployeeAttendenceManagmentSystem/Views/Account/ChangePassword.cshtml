@model EmployeeAttendenceManagmentSystem.Models.DTOs.ChangePasswordDto
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewBag.Title = "Change password";
}

<section class="page-head">
    <div>
        <h2>Change password</h2>
        <p class="person">Choose a new password for your account.</p>
    </div>
</section>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success form-alert" role="status">@TempData["Success"]</div>
}

@using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { id = "changeForm", @class = "form-card", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-error" })

    <div class="f-group">
        <label for="CurrentPassword">Current password</label>
        @Html.PasswordFor(m => m.CurrentPassword, new { @class = "f-input", autocomplete = "current-password", autofocus = "autofocus" })
        @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "f-error" })
    </div>

    <div class="f-group">
        <label for="NewPassword">New password</label>
        @Html.PasswordFor(m => m.NewPassword, new { @class = "f-input", autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "f-error" })
        <p class="f-hint">Use 6 to 50 characters.</p>
    </div>

    <div class="f-group">
        <label for="ConfirmPassword">Confirm new password</label>
        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "f-input", autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "f-error" })
    </div>

    <label class="f-check"><input type="checkbox" id="showPass" /> Show passwords</label>

    <button type="submit" class="btn-primary">Change password</button>
}

<script>
    (function () {
        var form = document.getElementById('changeForm');
        var show = document.getElementById('showPass');
        show.addEventListener('change', function () {
            var t = show.checked ? 'text' : 'password';
            form.CurrentPassword.type = t;
            form.NewPassword.type = t;
            form.ConfirmPassword.type = t;
        });
    })();
</script>