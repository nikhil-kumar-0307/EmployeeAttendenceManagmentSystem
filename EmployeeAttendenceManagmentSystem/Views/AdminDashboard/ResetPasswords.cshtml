@model EmployeeAttendenceManagmentSystem.Models.ViewModels.ResetPasswordsVm
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewBag.Title = "Reset passwords";
    Func<string, string> ini = n => string.IsNullOrWhiteSpace(n) ? "?" : n.Trim().Substring(0, 1).ToUpper();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error" role="alert">@TempData["Error"]</div>
}

<section class="page-head">
    <div>
        <a class="back-link" href="@Url.Action("Index", "AdminDashboard")">&larr; Back to home</a>
        <h2>Reset passwords</h2>
        <p class="person">Set an employee's password back to their date of birth in QMS. This also clears a sign-in lock.</p>
    </div>
</section>

<section class="panel block">
    <div class="panel-head"><h3>Find an employee</h3></div>
    <div class="panel-body">
        <form method="get" class="search-row">
            <div class="search-box">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" name="q" value="@Model.Query" placeholder="Search by name, employee number or department" autofocus />
            </div>
            <button type="submit" class="btn-primary">Search</button>
        </form>

        @if (Model.Query.Length > 0)
        {
            if (Model.Results.Count == 0)
            {
                <div class="empty">No employee matches "@Model.Query".</div>
            }
            else
            {
                <div class="table-wrap result-table">
                    <table class="data-table">
                        <thead>
                            <tr><th>Employee</th><th>Designation</th><th>Department</th><th>Password</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Results)
                            {
                                <tr>
                                    <td>
                                        <div class="person-cell">
                                            <span class="avatar">@ini(r.Name)</span>
                                            <div><div class="p-name">@r.Name</div><div class="p-sub">Emp. No @r.EmployeeNo</div></div>
                                        </div>
                                    </td>
                                    <td>@r.Designation</td>
                                    <td>@r.Department</td>
                                    <td>
                                        @if (r.HasCustomPassword)
                                        {
                                            <span class="badge b-leave">Changed</span>
                                        }
                                        else
                                        {
                                            <span class="badge b-weeklyoff">Date of birth</span>
                                        }
                                    </td>
                                    <td class="td-right">
                                        @using (Html.BeginForm("ResetPassword", "AdminDashboard", FormMethod.Post, new { @class = "inline-form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="employeeNo" value="@r.EmployeeNo" />
                                            <input type="hidden" name="q" value="@Model.Query" />
                                            <button type="submit" class="btn-danger" onclick="return confirm('Set this employee\'s password back to the date of birth?');">Reset to date of birth</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</section>