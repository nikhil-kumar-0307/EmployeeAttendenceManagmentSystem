@model EmployeeAttendenceManagmentSystem.Models.ViewModels.EmployeeHomeVm
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewBag.Title = "Home";
}

<section class="hello">
    <h1>Hello, @Model.DisplayName</h1>
    <p>Choose the attendance you want to view.</p>

    @if (TempData["Info"] != null)
    {
        <div class="notice">@TempData["Info"]</div>
    }
</section>

<section class="workspace-grid">

    <article class="ws-card ws-blue">
        <div class="ws-icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /><path d="M9 16l2 2 4-4" /></svg>
        </div>
        <h2>My attendance</h2>
        <p>See your daily in and out time, leave and a summary for each month.</p>
        <a class="ws-btn" href="@Url.Action("MyAttendance", "EmployeeDashboard")">
            View my attendance
            <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
        </a>
    </article>

    <article class="ws-card ws-green">
        <div class="ws-icon">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        </div>
        <h2>Subordinate attendance</h2>
        <p>
            Check who is present, on leave or absent in your team.
            @if (Model.SubordinateCount > 0)
            {
                <span class="count">@Model.SubordinateCount employee@(Model.SubordinateCount == 1 ? "" : "s") report to you</span>
            }
        </p>
        @if (Model.SubordinateCount > 0)
        {
            <a class="ws-btn" href="@Url.Action("SubordinateAttendance", "EmployeeDashboard")">
                View subordinate attendance
                <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
            </a>
        }
        else
        {
            <span class="ws-btn ws-disabled">No subordinates assigned</span>
        }
    </article>

</section>
