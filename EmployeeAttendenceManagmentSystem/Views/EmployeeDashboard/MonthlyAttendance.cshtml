@model EmployeeAttendenceManagmentSystem.Models.ViewModels.MonthlyAttendanceVm
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewBag.Title = Model.IsSelf ? "My attendance" : "Subordinate attendance";
    var subtitle = string.Join(", ", new[] { Model.Designation, Model.Department }.Where(x => !string.IsNullOrEmpty(x)));
}

<section class="page-head">
    <div>
        @if (!Model.IsSelf)
        {
            <a class="back-link" href="@Url.Action("SubordinateAttendance", "EmployeeDashboard")">&larr; Back to subordinate attendance</a>
        }
        <h2>@(Model.IsSelf ? "My attendance" : Model.EmployeeName)</h2>
        <p class="person">
            @Model.EmployeeName, Emp. No @Model.EmployeeNo
            @if (subtitle.Length > 0)
            {
                <br />@subtitle
            }
        </p>
    </div>

    <form method="get" class="toolbar">
        @if (!Model.IsSelf)
        {
            <input type="hidden" name="employeeNo" value="@Model.EmployeeNo" />
        }
        <label for="month">Month</label>
        <input type="month" id="month" name="month" value="@Model.Month.ToString("yyyy-MM")" />
        <button type="submit" class="btn-primary">Show</button>
    </form>
</section>

<section class="tiles">
    <div class="tile t-present"><span class="num">@Model.Present</span><span class="lbl">Present</span></div>
    <div class="tile t-absent"><span class="num">@Model.Absent</span><span class="lbl">Absent</span></div>
    <div class="tile t-off"><span class="num">@Model.WeeklyOff</span><span class="lbl">Weekly off</span></div>
    <div class="tile t-total"><span class="num">@Model.NotMarked</span><span class="lbl">Not marked yet</span></div>
</section>

<section class="panel">
    <h3 class="panel-title">@Model.Month.ToString("MMMM yyyy")</h3>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Status</th>
                    <th>In</th>
                    <th>Out</th>
                    <th>Hours</th>
                    <th>Punches</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Date.ToString("dd MMM yyyy")</td>
                        <td>@r.Date.ToString("dddd")</td>
                        <td><span class="badge b-@r.StatusClass">@r.Status</span></td>
                        <td>@r.InText</td>
                        <td>@r.OutText</td>
                        <td>@r.HoursText</td>
                        <td>@(r.Punches > 0 ? r.Punches.ToString() : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
